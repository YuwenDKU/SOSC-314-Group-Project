# ============================================================
# INSPECT EMBEDDING CLUSTERS
# ============================================================

from collections import Counter
import pandas as pd

CLUSTER_FILE = "embedding_clusters.xlsx"
TOKEN_FILE = "train_posts_tokenized.xlsx"
OUT = "cluster_inspection.xlsx"

# ---------- load ----------
df = pd.read_excel(CLUSTER_FILE,dtype={"post_id": str})
tokens = pd.read_excel(TOKEN_FILE,dtype={"post_id": str})

# ---------- match tokenized text ----------
df = df.merge(tokens[["post_id", "tokenized"]],on="post_id",how="left",validate="one_to_one")
df["tokenized"] = df["tokenized"].fillna("")

# ---------- inspect clusters ----------
summary = []
for cluster in sorted(df["cluster"].astype(int).unique()):
    cluster_df = df[df["cluster"].astype(int) == cluster]
    word_counts = Counter(" ".join(cluster_df["tokenized"]).split())
    top_words = ", ".join(word for word, count in word_counts.most_common(20))

    summary.append({"cluster": cluster,
                         "post_count": len(cluster_df),
                         "top_words": top_words})

# ---------- save ----------
summary_df = pd.DataFrame(summary)
summary_df.to_excel(OUT,sheet_name="cluster_summary",index=False)

print(summary_df.to_string(index=False))
print(f"\nSaved: {OUT}")
